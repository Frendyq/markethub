// MarketHub database schema.
// Tables and columns use snake_case so that the Rust pricing-engine (sqlx)
// and plain SQL read naturally. Money is numeric, never float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
}

enum StockMovementType {
  RECEIPT // goods arrived
  ADJUSTMENT // manual correction after a stock count
  RESERVE // reserved for an order
  RELEASE // reservation returned (order cancelled)
  SHIPMENT // goods left the warehouse
}

enum OrderStatus {
  RESERVED // stock is reserved, waiting to be shipped
  BACKORDERED // not enough stock when the order came in
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SyncStatus {
  SUCCEEDED
  SKIPPED // nothing changed since the last push, no API call made
  FAILED
}

enum ListingStatus {
  DRAFT // created here, never pushed
  PENDING // a push is queued
  ACTIVE // live on the marketplace
  PAUSED // hidden on the marketplace (no stock or paused by a rule)
  ERROR // the last push failed after all retries
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(MANAGER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  title       String
  description String?
  category    String
  ean         String?  @unique
  // Catalog prices are kept in EUR; the pricing-engine converts them per marketplace.
  costPrice   Decimal  @map("cost_price") @db.Decimal(12, 2)
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  weightKg    Decimal  @map("weight_kg") @db.Decimal(8, 3)
  widthCm     Int      @map("width_cm")
  heightCm    Int      @map("height_cm")
  depthCm     Int      @map("depth_cm")
  imageUrl    String?  @map("image_url")
  // Where it sits in the warehouse, e.g. "A-03-2" (aisle, rack, shelf).
  location    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  inventory      Inventory?
  stockMovements StockMovement[]
  listings       Listing[]
  orderItems     OrderItem[]

  @@index([category])
  @@map("products")
}

// One row per product. available = on_hand - reserved.
// CHECK constraints in the migration make overselling impossible at the database level.
model Inventory {
  productId Int      @id @map("product_id")
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model StockMovement {
  id        Int               @id @default(autoincrement())
  productId Int               @map("product_id")
  type      StockMovementType
  // Signed change of on_hand (RECEIPT, ADJUSTMENT, SHIPMENT) or of reserved (RESERVE, RELEASE).
  quantity  Int
  reason    String?
  userId    Int?              @map("user_id")
  orderId   Int?              @map("order_id")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Marketplace {
  id                Int       @id @default(autoincrement())
  code              String    @unique // amazon, ebay, otto, kaufland
  name              String
  country           String // ISO 3166-1 alpha-2
  currency          String // ISO 4217
  feePercent        Decimal   @map("fee_percent") @db.Decimal(5, 2)
  vatPercent        Decimal   @map("vat_percent") @db.Decimal(5, 2)
  // Requests per second the marketplace API allows; the worker respects it.
  rateLimitPerSec   Int       @default(5) @map("rate_limit_per_sec")
  isEnabled         Boolean   @default(true) @map("is_enabled")
  // Orders created before this moment have been pulled already.
  ordersSyncedUntil DateTime? @map("orders_synced_until") @db.Timestamptz(3)

  listings          Listing[]
  orders            Order[]
  processedWebhooks ProcessedWebhook[]

  @@map("marketplaces")
}

model ExchangeRate {
  currency  String   @id
  // How many units of this currency one EUR buys.
  perEur    Decimal  @map("per_eur") @db.Decimal(14, 6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("exchange_rates")
}

model Listing {
  id            Int           @id @default(autoincrement())
  productId     Int           @map("product_id")
  marketplaceId Int           @map("marketplace_id")
  externalId    String?       @map("external_id")
  status        ListingStatus @default(DRAFT)
  // What was last sent to the marketplace.
  price         Decimal?      @db.Decimal(12, 2)
  currency      String?
  quantity      Int?
  lastSyncHash  String?       @map("last_sync_hash")
  lastSyncedAt  DateTime?     @map("last_synced_at") @db.Timestamptz(3)
  lastError     String?       @map("last_error")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace Marketplace @relation(fields: [marketplaceId], references: [id])

  @@unique([productId, marketplaceId])
  @@index([marketplaceId, status])
  @@map("listings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String // "POST /products", "PATCH /inventory/12" ...
  entity    String?
  entityId  String?  @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

model Order {
  id            Int         @id @default(autoincrement())
  marketplaceId Int         @map("marketplace_id")
  externalId    String      @map("external_id")
  status        OrderStatus
  currency      String
  totalAmount   Decimal     @map("total_amount") @db.Decimal(12, 2)
  customerName  String?     @map("customer_name")
  placedAt      DateTime    @map("placed_at") @db.Timestamptz(3)
  shippedAt     DateTime?   @map("shipped_at") @db.Timestamptz(3)
  cancelledAt   DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  marketplace    Marketplace     @relation(fields: [marketplaceId], references: [id])
  items          OrderItem[]
  stockMovements StockMovement[]

  // The same marketplace order can arrive twice (webhook retry, webhook + polling): it is stored once.
  @@unique([marketplaceId, externalId])
  @@index([status, placedAt])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int?    @map("product_id")
  sku       String
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// Webhook deliveries already handled. A marketplace may deliver the same event more than once.
model ProcessedWebhook {
  id            Int      @id @default(autoincrement())
  marketplaceId Int      @map("marketplace_id")
  eventId       String   @map("event_id")
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  marketplace Marketplace @relation(fields: [marketplaceId], references: [id])

  @@unique([marketplaceId, eventId])
  @@map("processed_webhooks")
}

// One row per finished sync job: what the queue did and why it failed.
model SyncRun {
  id            Int        @id @default(autoincrement())
  marketplaceId Int?       @map("marketplace_id")
  listingId     Int?       @map("listing_id")
  jobName       String     @map("job_name")
  jobId         String?    @map("job_id")
  status        SyncStatus
  attempts      Int
  durationMs    Int?       @map("duration_ms")
  error         String?
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([listingId])
  @@map("sync_runs")
}

// Requests already handled, by the key the client sent in the Idempotency-Key header.
// Written in the same transaction as the operation, so a retried request is never applied twice.
model IdempotencyKey {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  key         String
  // "POST /orders/12/ship": reusing a key for a different request is an error.
  fingerprint String
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}
