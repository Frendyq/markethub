// MarketHub database schema.
// Tables and columns use snake_case so that the Rust pricing-engine (sqlx)
// and plain SQL read naturally. Money is numeric, never float.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
}

enum StockMovementType {
  RECEIPT // goods arrived
  ADJUSTMENT // manual correction after a stock count
  RESERVE // reserved for an order
  RELEASE // reservation returned (order cancelled)
  SHIPMENT // goods left the warehouse
}

enum ListingStatus {
  DRAFT // created here, never pushed
  PENDING // a push is queued
  ACTIVE // live on the marketplace
  PAUSED // hidden on the marketplace (no stock or paused by a rule)
  ERROR // the last push failed after all retries
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(MANAGER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  title       String
  description String?
  category    String
  ean         String?  @unique
  // Catalog prices are kept in EUR; the pricing-engine converts them per marketplace.
  costPrice   Decimal  @map("cost_price") @db.Decimal(12, 2)
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  weightKg    Decimal  @map("weight_kg") @db.Decimal(8, 3)
  widthCm     Int      @map("width_cm")
  heightCm    Int      @map("height_cm")
  depthCm     Int      @map("depth_cm")
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  inventory      Inventory?
  stockMovements StockMovement[]
  listings       Listing[]

  @@index([category])
  @@map("products")
}

// One row per product. available = on_hand - reserved.
// CHECK constraints in the migration make overselling impossible at the database level.
model Inventory {
  productId Int      @id @map("product_id")
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model StockMovement {
  id        Int               @id @default(autoincrement())
  productId Int               @map("product_id")
  type      StockMovementType
  // Signed change of on_hand (RECEIPT, ADJUSTMENT, SHIPMENT) or of reserved (RESERVE, RELEASE).
  quantity  Int
  reason    String?
  userId    Int?              @map("user_id")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Marketplace {
  id              Int     @id @default(autoincrement())
  code            String  @unique // amazon, ebay, otto, kaufland
  name            String
  country         String // ISO 3166-1 alpha-2
  currency        String // ISO 4217
  feePercent      Decimal @map("fee_percent") @db.Decimal(5, 2)
  vatPercent      Decimal @map("vat_percent") @db.Decimal(5, 2)
  // Requests per second the marketplace API allows; the worker respects it.
  rateLimitPerSec Int     @default(5) @map("rate_limit_per_sec")
  isEnabled       Boolean @default(true) @map("is_enabled")

  listings Listing[]

  @@map("marketplaces")
}

model ExchangeRate {
  currency  String   @id
  // How many units of this currency one EUR buys.
  perEur    Decimal  @map("per_eur") @db.Decimal(14, 6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("exchange_rates")
}

model Listing {
  id            Int           @id @default(autoincrement())
  productId     Int           @map("product_id")
  marketplaceId Int           @map("marketplace_id")
  externalId    String?       @map("external_id")
  status        ListingStatus @default(DRAFT)
  // What was last sent to the marketplace.
  price         Decimal?      @db.Decimal(12, 2)
  currency      String?
  quantity      Int?
  lastSyncHash  String?       @map("last_sync_hash")
  lastSyncedAt  DateTime?     @map("last_synced_at") @db.Timestamptz(3)
  lastError     String?       @map("last_error")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace Marketplace @relation(fields: [marketplaceId], references: [id])

  @@unique([productId, marketplaceId])
  @@index([marketplaceId, status])
  @@map("listings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String // "POST /products", "PATCH /inventory/12" ...
  entity    String?
  entityId  String?  @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}
