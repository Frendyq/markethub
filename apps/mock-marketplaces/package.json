{
  "name": "@markethub/mock-marketplaces",
  "version": "0.1.0",
  "description": "Local stand-ins for the Amazon, eBay, OTTO and Kaufland seller APIs, with rate limits, errors and webhooks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
